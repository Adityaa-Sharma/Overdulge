# Overdulge — local environment template.
# Copy to `.env` (gitignored) and fill in. These same values live as GitHub
# Actions secrets in production; see README "Bootstrap checklist" §2–3.
# NEVER commit a filled-in .env.

# ─── Agent loop (claude-code-action) ────────────────────────────────────────
# Long-lived OAuth token from `claude setup-token` (requires Claude Pro/Max).
# Agent runs bill against the subscription, not API credits.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub App identity — makes bot→bot triggers work. From Settings → Apps.
APP_ID=
# Paste the full PEM. For multi-line in .env, wrap in quotes and keep newlines,
# or point to the file instead, e.g. APP_PRIVATE_KEY="$(cat overdulge.*.pem)".
APP_PRIVATE_KEY=

# ─── Cloudflare Workers (deploy) ────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Product LLM (powers the Worker, NOT the agents) ────────────────────────
# Provider-agnostic via LangChain's `init_chat_model` (BRD §3). Current
# provider is Groq; a later move to Azure OpenAI is a config-only change.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# Request-level deadline for POST /api/v1/query (FR-4 AC-5, <10s interactive
# target) — kept under 10 so the route's own error envelope wins the race
# against a client-side timeout.
QUERY_TIMEOUT_SECONDS=9
# Retained for the planned Azure OpenAI migration (BRD §3) — unused while
# LLM_PROVIDER=groq.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# ─── Supabase (Worker data store) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Token encryption (ADR-0001) ────────────────────────────────────────────
# AES-256-GCM key: 32 random bytes, base64-encoded, generated once
# (e.g. `openssl rand -base64 32`). Never in the repo.
TOKEN_ENCRYPTION_KEY=

# ─── OAuth link flow (ADR-0001) ─────────────────────────────────────────────
# Backend's own public URL; used to build the OAuth redirect_uri
# (<BACKEND_BASE_URL>/api/v1/links/{platform}/callback) sent to DCR
# registration and the authorization request.
BACKEND_BASE_URL=
# Frontend settings route the callback redirects the browser back to, e.g.
# https://<user>.github.io/Overdulge/settings — never a token or code.
FRONTEND_SETTINGS_URL=

# ─── Weekly digest — Resend (ADR-0007 §3) ───────────────────────────────────
RESEND_API_KEY=
DIGEST_FROM_EMAIL=

# ─── Frontend (Vite, bundled into the client build — frontend-safe only) ───
# Same Supabase project as above; anon key is public by design. NEVER put
# SUPABASE_SERVICE_ROLE_KEY in a VITE_-prefixed variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
